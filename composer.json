{
    "name": "villaflor/taboola-sdk",
    "description": "This package contains the open source PHP SDK that allows you to access the Taboola Platform from your PHP application.",
    "keywords": [
        "villaflor",
        "taboola",
        "taboola-sdk",
        "api",
        "sdk"
    ],
    "homepage": "https://github.com/villaflor/taboola-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Anthony Villaflor",
            "email": "villaflor@live.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "villaflor/connection": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Villaflor\\TaboolaSDK\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Villaflor\\TaboolaSDK\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
